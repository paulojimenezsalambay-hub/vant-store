# URL del webhook de n8n para enviar las respuestas del quiz
N8N_WEBHOOK_URL=https://n8n.tudominio.com/webhook/quiz-lead

# Shopify Storefront API (público, expuesto al cliente con NEXT_PUBLIC_)
NEXT_PUBLIC_SHOPIFY_DOMAIN=tu-tienda.myshopify.com
NEXT_PUBLIC_SHOPIFY_STOREFRONT_TOKEN=

# Token compartido para validar requests entre frontend y n8n
N8N_SHARED_SECRET=cambia-esto-en-produccion
