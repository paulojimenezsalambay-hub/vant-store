{
  "name": "01 — Lead Magnet · Quiz → OpenAI → WhatsApp",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "quiz-lead",
        "responseMode": "responseNode",
        "options": {}
      },
      "name": "Webhook · Quiz Submitted",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1.1,
      "position": [240, 320],
      "id": "wh-quiz-lead",
      "webhookId": "quiz-lead"
    },
    {
      "parameters": {
        "values": {
          "string": [
            {"name": "email", "value": "={{ $json.body.email }}"},
            {"name": "phone_e164", "value": "={{ $json.body.phone }}"},
            {"name": "nombre", "value": "={{ $json.body.nombre }}"}
          ],
          "object": [
            {"name": "respuestas", "value": "={{ $json.body.respuestas }}"}
          ]
        },
        "options": {}
      },
      "name": "Normalizar Payload",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3,
      "position": [460, 320],
      "id": "set-normalize"
    },
    {
      "parameters": {
        "resource": "chat",
        "model": "gpt-4o",
        "messages": {
          "values": [
            {
              "role": "system",
              "content": "Eres un perfumista experto y psicólogo del consumidor. A partir de las respuestas del quiz, devuelve un JSON estricto con: { arquetipo: 'Sabio|Amante|Creador|Héroe|Mago|Inocente', familia_recomendada: 'oriental|chipre|amaderada|cítrica|floral|fougère', intensidad: 'discreta|equilibrada|envolvente', justificacion: '<2 frases en tono editorial de lujo>', sku_recomendado: '<elige uno de los SKU disponibles>' }. NO incluyas texto fuera del JSON."
            },
            {
              "role": "user",
              "content": "=Respuestas del quiz: {{ JSON.stringify($json.respuestas) }}\n\nCatálogo disponible: [OLF-001-EDP-100 (oriental, envolvente, vainilla/ámbar/oud), OLF-002-EDP-100 (chipre, equilibrada, bergamota/jazmín/musgo), OLF-003-EDP-100 (amaderada, discreta, cedro/iris/papiro), OLF-004-EDP-100 (cítrica, discreta, neroli/petitgrain/almizcle), OLF-005-EDP-100 (floral, equilibrada, tuberosa/rosa/sándalo)]"
            }
          ]
        },
        "jsonOutput": true,
        "options": {"temperature": 0.4}
      },
      "name": "OpenAI · Perfil + Match",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 1.6,
      "position": [680, 320],
      "id": "openai-profile"
    },
    {
      "parameters": {
        "operation": "upsert",
        "base": {"__rl": true, "value": "appXXXXXXXXXXXXXX", "mode": "id"},
        "table": {"__rl": true, "value": "tblLeadsXXXXXXX", "mode": "id"},
        "matchColumns": ["email"],
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "email": "={{ $('Normalizar Payload').item.json.email }}",
            "phone_e164": "={{ $('Normalizar Payload').item.json.phone_e164 }}",
            "nombre": "={{ $('Normalizar Payload').item.json.nombre }}",
            "quiz_respuestas": "={{ JSON.stringify($('Normalizar Payload').item.json.respuestas) }}",
            "perfil_arquetipo": "={{ $json.message.content.arquetipo }}",
            "recomendacion_sku": "={{ $json.message.content.sku_recomendado }}",
            "segmento": "Lead",
            "consent_whatsapp": true,
            "consent_timestamp": "={{ $now.toISO() }}"
          }
        },
        "options": {}
      },
      "name": "Airtable · Upsert Lead",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2.1,
      "position": [900, 320],
      "id": "airtable-upsert"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v20.0/{{ $env.WA_PHONE_NUMBER_ID }}/messages",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"messaging_product\": \"whatsapp\",\n  \"to\": \"{{ $('Normalizar Payload').item.json.phone_e164 }}\",\n  \"type\": \"template\",\n  \"template\": {\n    \"name\": \"recomendacion_quiz\",\n    \"language\": {\"code\": \"es\"},\n    \"components\": [\n      {\"type\": \"body\", \"parameters\": [\n        {\"type\": \"text\", \"text\": \"{{ $('Normalizar Payload').item.json.nombre }}\"},\n        {\"type\": \"text\", \"text\": \"{{ $('OpenAI · Perfil + Match').item.json.message.content.arquetipo }}\"},\n        {\"type\": \"text\", \"text\": \"{{ $('OpenAI · Perfil + Match').item.json.message.content.justificacion }}\"},\n        {\"type\": \"text\", \"text\": \"{{ $('OpenAI · Perfil + Match').item.json.message.content.sku_recomendado }}\"}\n      ]}\n    ]\n  }\n}",
        "options": {}
      },
      "name": "WhatsApp Cloud · Recomendación",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1120, 320],
      "id": "wa-send"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={ \"ok\": true, \"perfil\": {{ JSON.stringify($('OpenAI · Perfil + Match').item.json.message.content) }} }"
      },
      "name": "Webhook · Response",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1340, 320],
      "id": "wh-respond"
    },
    {
      "parameters": {
        "amount": 2,
        "unit": "days"
      },
      "name": "Wait · D+2",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [1120, 520],
      "id": "wait-2d",
      "webhookId": "wait-2d-quiz"
    },
    {
      "parameters": {
        "operation": "search",
        "base": {"__rl": true, "value": "appXXXXXXXXXXXXXX", "mode": "id"},
        "table": {"__rl": true, "value": "tblLeadsXXXXXXX", "mode": "id"},
        "filterByFormula": "=AND({email}='{{ $('Normalizar Payload').item.json.email }}', {segmento}='Lead')"
      },
      "name": "Airtable · ¿Sigue como Lead?",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2.1,
      "position": [1340, 520],
      "id": "airtable-check"
    },
    {
      "parameters": {
        "conditions": {
          "number": [
            {"value1": "={{ $json.length || 0 }}", "operation": "larger", "value2": 0}
          ]
        }
      },
      "name": "IF · No ha comprado",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1560, 520],
      "id": "if-still-lead"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v20.0/{{ $env.WA_PHONE_NUMBER_ID }}/messages",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"messaging_product\": \"whatsapp\",\n  \"to\": \"{{ $('Normalizar Payload').item.json.phone_e164 }}\",\n  \"type\": \"template\",\n  \"template\": {\n    \"name\": \"recomendacion_quiz_reminder\",\n    \"language\": {\"code\": \"es\"}\n  }\n}",
        "options": {}
      },
      "name": "WhatsApp · Reminder D+2",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1780, 520],
      "id": "wa-reminder"
    }
  ],
  "connections": {
    "Webhook · Quiz Submitted": {"main": [[{"node": "Normalizar Payload", "type": "main", "index": 0}]]},
    "Normalizar Payload": {"main": [[{"node": "OpenAI · Perfil + Match", "type": "main", "index": 0}]]},
    "OpenAI · Perfil + Match": {"main": [[{"node": "Airtable · Upsert Lead", "type": "main", "index": 0}]]},
    "Airtable · Upsert Lead": {"main": [[{"node": "WhatsApp Cloud · Recomendación", "type": "main", "index": 0}]]},
    "WhatsApp Cloud · Recomendación": {"main": [[{"node": "Webhook · Response", "type": "main", "index": 0}, {"node": "Wait · D+2", "type": "main", "index": 0}]]},
    "Wait · D+2": {"main": [[{"node": "Airtable · ¿Sigue como Lead?", "type": "main", "index": 0}]]},
    "Airtable · ¿Sigue como Lead?": {"main": [[{"node": "IF · No ha comprado", "type": "main", "index": 0}]]},
    "IF · No ha comprado": {"main": [[{"node": "WhatsApp · Reminder D+2", "type": "main", "index": 0}], []]}
  },
  "active": false,
  "settings": {"executionOrder": "v1"},
  "versionId": "1.0.0"
}
