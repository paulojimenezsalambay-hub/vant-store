    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const records = $input.first().json.records || [];\nconst productos = {};\nconst stockBajo = [];\n\nfor (const record of records) {\n  const f = record.fields || {};\n  const id = String(f.ID_Producto || '').trim();\n  if (!id) continue;\n\n  const stock = Number(f.Stock_Disponible) || 0;\n\n  productos[id] = {\n    ID_Producto:      id,\n    Nombre:           f.Nombre            || '',\n    Precio_Original:  f.Precio_Original   || 0,\n    Precio_Oferta:    f.Precio_Oferta     || 0,\n    En_Oferta:        Boolean(f.En_Oferta),\n    Etiqueta_Oferta:  f.Etiqueta_Oferta   || '',\n    Foto:             Array.isArray(f.Foto) ? f.Foto : [],\n    Stock_Disponible: stock,\n    Ventas_Totales:   Number(f.Ventas_Totales) || 0,\n    Es_Top:           Boolean(f.Es_Top)\n  };\n\n  if (stock > 0 && stock < 5) {\n    stockBajo.push({ id, nombre: f.Nombre || id, stock });\n  }\n}\n\nreturn [{ json: { productos, stockBajo } }];"
      },
      "name": "Code · Transformar + Stock Bajo",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [680, 300],
      "id": "c2d3e4f5-a6b7-8901-cdef-234567890103"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify($json.productos) }}",
        "options": {
