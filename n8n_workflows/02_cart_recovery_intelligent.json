{
  "name": "02 — Cart Recovery Inteligente (Shopify + OpenAI + WhatsApp)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "cart-abandoned",
        "responseMode": "onReceived",
        "options": {}
      },
      "name": "Webhook Shopify · checkouts/update",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1.1,
      "position": [240, 320],
      "id": "wh-shopify-cart",
      "webhookId": "cart-abandoned"
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {"value1": "={{ $json.body.abandoned_checkout_url }}", "operation": "isNotEmpty"}
          ],
          "number": [
            {"value1": "={{ Number($json.body.total_price) || 0 }}", "operation": "larger", "value2": 0}
          ]
        }
      },
      "name": "IF · Carrito abandonado válido",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [460, 320],
      "id": "if-valid-cart"
    },
    {
      "parameters": {
        "values": {
          "string": [
            {"name": "email", "value": "={{ $json.body.email }}"},
            {"name": "phone_e164", "value": "={{ $json.body.phone || $json.body.shipping_address?.phone || '' }}"},
            {"name": "checkout_url", "value": "={{ $json.body.abandoned_checkout_url }}"},
            {"name": "total_price", "value": "={{ $json.body.total_price }}"},
            {"name": "currency", "value": "={{ $json.body.currency }}"},
            {"name": "line_items", "value": "={{ JSON.stringify($json.body.line_items) }}"}
          ]
        }
      },
      "name": "Extraer datos del carrito",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3,
      "position": [680, 280],
      "id": "set-cart"
    },
    {
      "parameters": {
        "amount": 1,
        "unit": "hours"
      },
      "name": "Wait · 1h",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [900, 280],
      "id": "wait-1h",
      "webhookId": "wait-1h-cart"
    },
    {
      "parameters": {
        "operation": "search",
        "base": {"__rl": true, "value": "appXXXXXXXXXXXXXX", "mode": "id"},
        "table": {"__rl": true, "value": "tblLeadsXXXXXXX", "mode": "id"},
        "filterByFormula": "={email}='{{ $('Extraer datos del carrito').item.json.email }}'"
      },
      "name": "Airtable · Lookup Lead",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2.1,
      "position": [1120, 280],
      "id": "airtable-lookup"
    },
    {
      "parameters": {
        "resource": "chat",
        "model": "gpt-4o-mini",
        "messages": {
          "values": [
            {
              "role": "system",
              "content": "Genera una oferta de recuperación de carrito personalizada. Devuelve JSON: { canal: 'whatsapp|email', tono: 'editorial|cercano|exclusivo', descuento_pct: 0|5|10|15, copy_principal: '<≤180 chars>', cta: '<≤40 chars>' }. Reglas: si total>120€ no usar descuento>10. Si segmento=VIP no usar descuento>5 (preferir regalo). Si phone vacío canal='email'."
            },
            {
              "role": "user",
              "content": "=Carrito: {{ $('Extraer datos del carrito').item.json.line_items }}\nTotal: {{ $('Extraer datos del carrito').item.json.total_price }} {{ $('Extraer datos del carrito').item.json.currency }}\nLead segmento: {{ $json[0]?.fields?.segmento || 'Lead' }}\nArquetipo: {{ $json[0]?.fields?.perfil_arquetipo || 'Sabio' }}\nTeléfono disponible: {{ $('Extraer datos del carrito').item.json.phone_e164 ? 'sí' : 'no' }}"
            }
          ]
        },
        "jsonOutput": true,
        "options": {"temperature": 0.5}
      },
      "name": "OpenAI · Oferta Personalizada",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 1.6,
      "position": [1340, 280],
      "id": "openai-offer"
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {"conditions": {"string": [{"value1": "={{ $json.message.content.canal }}", "value2": "whatsapp"}]}, "outputKey": "whatsapp"},
            {"conditions": {"string": [{"value1": "={{ $json.message.content.canal }}", "value2": "email"}]}, "outputKey": "email"}
          ]
        }
      },
      "name": "Switch · Canal",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [1560, 280],
      "id": "switch-channel"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v20.0/{{ $env.WA_PHONE_NUMBER_ID }}/messages",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"messaging_product\": \"whatsapp\",\n  \"to\": \"{{ $('Extraer datos del carrito').item.json.phone_e164 }}\",\n  \"type\": \"template\",\n  \"template\": {\n    \"name\": \"cart_recovery\",\n    \"language\": {\"code\": \"es\"},\n    \"components\": [\n      {\"type\": \"body\", \"parameters\": [\n        {\"type\": \"text\", \"text\": \"{{ $('OpenAI · Oferta Personalizada').item.json.message.content.copy_principal }}\"},\n        {\"type\": \"text\", \"text\": \"{{ $('OpenAI · Oferta Personalizada').item.json.message.content.descuento_pct }}\"}\n      ]},\n      {\"type\": \"button\", \"sub_type\": \"url\", \"index\": \"0\", \"parameters\": [\n        {\"type\": \"text\", \"text\": \"{{ $('Extraer datos del carrito').item.json.checkout_url }}\"}\n      ]}\n    ]\n  }\n}",
        "options": {}
      },
      "name": "WhatsApp · Cart Recovery",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1780, 200],
      "id": "wa-cart"
    },
    {
      "parameters": {
        "fromEmail": "hola@olfativa.ai",
        "toEmail": "={{ $('Extraer datos del carrito').item.json.email }}",
        "subject": "=Tu fragancia te espera — {{ $('OpenAI · Oferta Personalizada').item.json.message.content.cta }}",
        "html": "=<div style=\"font-family: Georgia, serif; max-width:560px; margin:0 auto;\">\n  <h1 style=\"font-weight:300; letter-spacing:2px;\">OLFATIVA</h1>\n  <p>{{ $('OpenAI · Oferta Personalizada').item.json.message.content.copy_principal }}</p>\n  <a href=\"{{ $('Extraer datos del carrito').item.json.checkout_url }}\" style=\"display:inline-block; padding:14px 28px; background:#111; color:#fff; text-decoration:none; letter-spacing:2px;\">{{ $('OpenAI · Oferta Personalizada').item.json.message.content.cta }}</a>\n</div>",
        "options": {}
      },
      "name": "SendGrid · Cart Email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [1780, 360],
      "id": "email-cart"
    },
    {
      "parameters": {
        "amount": 23,
        "unit": "hours"
      },
      "name": "Wait · 23h (D+1)",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [2000, 280],
      "id": "wait-23h",
      "webhookId": "wait-23h-cart"
    },
    {
      "parameters": {
        "url": "=https://{{ $env.SHOPIFY_DOMAIN }}/admin/api/2024-10/checkouts/{{ $('Webhook Shopify · checkouts/update').item.json.body.token }}.json",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "shopifyApi",
        "options": {}
      },
      "name": "Shopify · ¿Sigue abierto?",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2220, 280],
      "id": "shopify-check"
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {"value1": "={{ $json.checkout?.completed_at || '' }}", "operation": "isEmpty"}
          ]
        }
      },
      "name": "IF · Aún sin comprar",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [2440, 280],
      "id": "if-still-open"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v20.0/{{ $env.WA_PHONE_NUMBER_ID }}/messages",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"messaging_product\": \"whatsapp\",\n  \"to\": \"{{ $('Extraer datos del carrito').item.json.phone_e164 }}\",\n  \"type\": \"template\",\n  \"template\": {\n    \"name\": \"cart_recovery_final\",\n    \"language\": {\"code\": \"es\"}\n  }\n}",
        "options": {}
      },
      "name": "WhatsApp · Último intento",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2660, 280],
      "id": "wa-final"
    }
  ],
  "connections": {
    "Webhook Shopify · checkouts/update": {"main": [[{"node": "IF · Carrito abandonado válido", "type": "main", "index": 0}]]},
    "IF · Carrito abandonado válido": {"main": [[{"node": "Extraer datos del carrito", "type": "main", "index": 0}], []]},
    "Extraer datos del carrito": {"main": [[{"node": "Wait · 1h", "type": "main", "index": 0}]]},
    "Wait · 1h": {"main": [[{"node": "Airtable · Lookup Lead", "type": "main", "index": 0}]]},
    "Airtable · Lookup Lead": {"main": [[{"node": "OpenAI · Oferta Personalizada", "type": "main", "index": 0}]]},
    "OpenAI · Oferta Personalizada": {"main": [[{"node": "Switch · Canal", "type": "main", "index": 0}]]},
    "Switch · Canal": {"main": [[{"node": "WhatsApp · Cart Recovery", "type": "main", "index": 0}], [{"node": "SendGrid · Cart Email", "type": "main", "index": 0}]]},
    "WhatsApp · Cart Recovery": {"main": [[{"node": "Wait · 23h (D+1)", "type": "main", "index": 0}]]},
    "SendGrid · Cart Email": {"main": [[{"node": "Wait · 23h (D+1)", "type": "main", "index": 0}]]},
    "Wait · 23h (D+1)": {"main": [[{"node": "Shopify · ¿Sigue abierto?", "type": "main", "index": 0}]]},
    "Shopify · ¿Sigue abierto?": {"main": [[{"node": "IF · Aún sin comprar", "type": "main", "index": 0}]]},
    "IF · Aún sin comprar": {"main": [[{"node": "WhatsApp · Último intento", "type": "main", "index": 0}], []]}
  },
  "active": false,
  "settings": {"executionOrder": "v1"},
  "versionId": "1.0.0"
}
