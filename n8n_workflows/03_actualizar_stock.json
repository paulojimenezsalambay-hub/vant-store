            { "name": "Authorization", "value": "Bearer pat7e7kEFGcyqdjzU.c447b332cfc5ac33096955062c215f8868cc524c4d03bf7c3f96766083132d47" }
          ]
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
