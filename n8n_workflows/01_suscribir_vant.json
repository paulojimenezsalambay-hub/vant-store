    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// La landing envía Content-Type: text/plain con JSON en el body\n// n8n puede meterlo en body como string o parsearlo directamente\nconst raw = $input.item.json;\nlet data;\nif (typeof raw.body === 'string') {\n  try { data = JSON.parse(raw.body); } catch(e) { data = {}; }\n} else if (raw.body && typeof raw.body === 'object') {\n  data = raw.body;\n} else {\n  data = raw;\n}\nconst email  = String(data.email  || '').toLowerCase().trim();\nconst origen = String(data.origen || 'newsletter');\nreturn { json: { email, origen } };"
      },
      "name": "Code · Parsear Body",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [460, 300],
      "id": "code-parse"
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.email }}",
              "operation": "regex",
              "value2": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$"
            }
          ]
        }
      },
      "name": "IF · Email Válido",
      "type": "n8n-nodes-base.if",
