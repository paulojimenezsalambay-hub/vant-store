{
  "name": "03 — Post-Venta · Recompra Predictiva (Replenishment)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "order-paid",
        "responseMode": "onReceived",
        "options": {}
      },
      "name": "Webhook Shopify · orders/paid",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1.1,
      "position": [240, 320],
      "id": "wh-order-paid",
      "webhookId": "order-paid"
    },
    {
      "parameters": {
        "fieldToSplitOut": "body.line_items",
        "options": {}
      },
      "name": "Split · Por SKU",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [460, 320],
      "id": "split-items"
    },
    {
      "parameters": {
        "operation": "search",
        "base": {"__rl": true, "value": "appXXXXXXXXXXXXXX", "mode": "id"},
        "table": {"__rl": true, "value": "tblProductosXXXX", "mode": "id"},
        "filterByFormula": "={sku}='{{ $json.sku }}'"
      },
      "name": "Airtable · Lookup Producto",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2.1,
      "position": [680, 320],
      "id": "airtable-product"
    },
    {
      "parameters": {
        "values": {
          "string": [
            {"name": "shopify_order_id", "value": "={{ $('Webhook Shopify · orders/paid').item.json.body.id }}"},
            {"name": "customer_email", "value": "={{ $('Webhook Shopify · orders/paid').item.json.body.email }}"},
            {"name": "customer_phone", "value": "={{ $('Webhook Shopify · orders/paid').item.json.body.shipping_address?.phone || '' }}"},
            {"name": "sku", "value": "={{ $('Split · Por SKU').item.json.sku }}"},
            {"name": "nombre", "value": "={{ $('Webhook Shopify · orders/paid').item.json.body.shipping_address?.first_name || '' }}"}
          ],
          "number": [
            {"name": "duracion_dias", "value": "={{ $json[0]?.fields?.duracion_dias_uso_medio || 75 }}"},
            {"name": "buffer_dias", "value": 10}
          ],
          "string2": [
            {"name": "recompra_objetivo_date", "value": "={{ $now.plus({ days: ($json[0]?.fields?.duracion_dias_uso_medio || 75) - 10 }).toFormat('yyyy-MM-dd') }}"}
          ]
        },
        "options": {}
      },
      "name": "Calcular fecha recompra",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3,
      "position": [900, 320],
      "id": "set-replenish-date"
    },
    {
      "parameters": {
        "operation": "create",
        "base": {"__rl": true, "value": "appXXXXXXXXXXXXXX", "mode": "id"},
        "table": {"__rl": true, "value": "tblPedidosXXXXXX", "mode": "id"},
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "shopify_order_id": "={{ $json.shopify_order_id }}",
            "sku": "={{ $json.sku }}",
            "customer_email": "={{ $json.customer_email }}",
            "customer_phone": "={{ $json.customer_phone }}",
            "recompra_objetivo_date": "={{ $json.recompra_objetivo_date }}",
            "recompra_msg_enviado": false
          }
        }
      },
      "name": "Airtable · Crear Pedido",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2.1,
      "position": [1120, 320],
      "id": "airtable-create-order"
    },
    {
      "parameters": {
        "rule": {"interval": [{"field": "days", "triggerAtHour": 9}]}
      },
      "name": "Cron · Diario 09:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [240, 600],
      "id": "cron-daily"
    },
    {
      "parameters": {
        "operation": "search",
        "base": {"__rl": true, "value": "appXXXXXXXXXXXXXX", "mode": "id"},
        "table": {"__rl": true, "value": "tblPedidosXXXXXX", "mode": "id"},
        "filterByFormula": "=AND({recompra_objetivo_date}=TODAY(), {recompra_msg_enviado}=FALSE())"
      },
      "name": "Airtable · Pedidos para hoy",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2.1,
      "position": [460, 600],
      "id": "airtable-due-orders"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://{{ $env.SHOPIFY_DOMAIN }}/admin/api/2024-10/draft_orders.json",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "shopifyApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"draft_order\": {\n    \"email\": \"{{ $json.fields.customer_email }}\",\n    \"line_items\": [{\"variant_id\": null, \"sku\": \"{{ $json.fields.sku }}\", \"quantity\": 1}],\n    \"use_customer_default_address\": true,\n    \"tags\": \"replenishment, autogenerado\"\n  }\n}",
        "options": {}
      },
      "name": "Shopify · Draft Order (Magic Link)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [680, 600],
      "id": "shopify-draft"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v20.0/{{ $env.WA_PHONE_NUMBER_ID }}/messages",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"messaging_product\": \"whatsapp\",\n  \"to\": \"{{ $('Airtable · Pedidos para hoy').item.json.fields.customer_phone }}\",\n  \"type\": \"template\",\n  \"template\": {\n    \"name\": \"replenishment_reminder\",\n    \"language\": {\"code\": \"es\"},\n    \"components\": [\n      {\"type\": \"body\", \"parameters\": [\n        {\"type\": \"text\", \"text\": \"{{ $('Airtable · Pedidos para hoy').item.json.fields.sku }}\"}\n      ]},\n      {\"type\": \"button\", \"sub_type\": \"url\", \"index\": \"0\", \"parameters\": [\n        {\"type\": \"text\", \"text\": \"{{ $json.draft_order.invoice_url }}\"}\n      ]}\n    ]\n  }\n}",
        "options": {}
      },
      "name": "WhatsApp · Recordatorio recompra",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [900, 600],
      "id": "wa-replenish"
    },
    {
      "parameters": {
        "operation": "update",
        "base": {"__rl": true, "value": "appXXXXXXXXXXXXXX", "mode": "id"},
        "table": {"__rl": true, "value": "tblPedidosXXXXXX", "mode": "id"},
        "id": "={{ $('Airtable · Pedidos para hoy').item.json.id }}",
        "columns": {
          "mappingMode": "defineBelow",
          "value": {"recompra_msg_enviado": true}
        }
      },
      "name": "Airtable · Marcar enviado",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2.1,
      "position": [1120, 600],
      "id": "airtable-mark-sent"
    }
  ],
  "connections": {
    "Webhook Shopify · orders/paid": {"main": [[{"node": "Split · Por SKU", "type": "main", "index": 0}]]},
    "Split · Por SKU": {"main": [[{"node": "Airtable · Lookup Producto", "type": "main", "index": 0}]]},
    "Airtable · Lookup Producto": {"main": [[{"node": "Calcular fecha recompra", "type": "main", "index": 0}]]},
    "Calcular fecha recompra": {"main": [[{"node": "Airtable · Crear Pedido", "type": "main", "index": 0}]]},
    "Cron · Diario 09:00": {"main": [[{"node": "Airtable · Pedidos para hoy", "type": "main", "index": 0}]]},
    "Airtable · Pedidos para hoy": {"main": [[{"node": "Shopify · Draft Order (Magic Link)", "type": "main", "index": 0}]]},
    "Shopify · Draft Order (Magic Link)": {"main": [[{"node": "WhatsApp · Recordatorio recompra", "type": "main", "index": 0}]]},
    "WhatsApp · Recordatorio recompra": {"main": [[{"node": "Airtable · Marcar enviado", "type": "main", "index": 0}]]}
  },
  "active": false,
  "settings": {"executionOrder": "v1"},
  "versionId": "1.0.0"
}
