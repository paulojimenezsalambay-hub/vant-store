{
  "name": "04 — Inventario Inteligente · Sync Proveedores + Alertas Slack",
  "nodes": [
    {
      "parameters": {
        "rule": {"interval": [{"field": "hours", "hoursInterval": 6}]}
      },
      "name": "Cron · Cada 6h",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [240, 320],
      "id": "cron-6h"
    },
    {
      "parameters": {
        "url": "={{ $env.PROVEEDOR_API_URL }}/v1/stock",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpHeaderAuth",
        "options": {"response": {"response": {"responseFormat": "json"}}}
      },
      "name": "HTTP · Proveedor Principal",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [460, 320],
      "id": "http-supplier"
    },
    {
      "parameters": {
        "fieldToSplitOut": "items",
        "options": {}
      },
      "name": "Split · SKUs proveedor",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [680, 320],
      "id": "split-supplier"
    },
    {
      "parameters": {
        "operation": "search",
        "base": {"__rl": true, "value": "appXXXXXXXXXXXXXX", "mode": "id"},
        "table": {"__rl": true, "value": "tblProductosXXXX", "mode": "id"},
        "filterByFormula": "={sku}='{{ $json.sku }}'"
      },
      "name": "Airtable · Lookup SKU",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2.1,
      "position": [900, 320],
      "id": "airtable-lookup-sku"
    },
    {
      "parameters": {
        "values": {
          "string": [
            {"name": "sku", "value": "={{ $('Split · SKUs proveedor').item.json.sku }}"},
            {"name": "airtable_id", "value": "={{ $json[0]?.id }}"}
          ],
          "number": [
            {"name": "stock_proveedor", "value": "={{ $('Split · SKUs proveedor').item.json.quantity }}"},
            {"name": "stock_actual", "value": "={{ $json[0]?.fields?.stock_actual || 0 }}"},
            {"name": "umbral_alerta", "value": "={{ $json[0]?.fields?.umbral_alerta || 10 }}"}
          ]
        }
      },
      "name": "Consolidar stock",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3,
      "position": [1120, 320],
      "id": "set-stock"
    },
    {
      "parameters": {
        "operation": "update",
        "base": {"__rl": true, "value": "appXXXXXXXXXXXXXX", "mode": "id"},
        "table": {"__rl": true, "value": "tblProductosXXXX", "mode": "id"},
        "id": "={{ $json.airtable_id }}",
        "columns": {
          "mappingMode": "defineBelow",
          "value": {"stock_actual": "={{ $json.stock_proveedor }}"}
        }
      },
      "name": "Airtable · Update stock",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2.1,
      "position": [1340, 320],
      "id": "airtable-update-stock"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://{{ $env.SHOPIFY_DOMAIN }}/admin/api/2024-10/inventory_levels/set.json",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "shopifyApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"location_id\": {{ $env.SHOPIFY_LOCATION_ID }},\n  \"inventory_item_id\": {{ $json.shopify_inventory_item_id || 0 }},\n  \"available\": {{ $('Consolidar stock').item.json.stock_proveedor }}\n}",
        "options": {}
      },
      "name": "Shopify · Sync inventario",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1560, 320],
      "id": "shopify-inventory-sync"
    },
    {
      "parameters": {
        "conditions": {
          "number": [
            {"value1": "={{ $('Consolidar stock').item.json.stock_proveedor }}", "operation": "smaller", "value2": "={{ $('Consolidar stock').item.json.umbral_alerta }}"}
          ]
        }
      },
      "name": "IF · Stock bajo umbral",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1340, 540],
      "id": "if-low-stock"
    },
    {
      "parameters": {
        "select": "channel",
        "channelId": {"__rl": true, "value": "C0000OPSINV", "mode": "id"},
        "text": "=:rotating_light: *Stock bajo* — SKU `{{ $('Consolidar stock').item.json.sku }}`\nDisponible: *{{ $('Consolidar stock').item.json.stock_proveedor }}* unidades (umbral: {{ $('Consolidar stock').item.json.umbral_alerta }}).\nDías estimados de cobertura: ~{{ Math.floor($('Consolidar stock').item.json.stock_proveedor / 2) }} días.\n<https://admin.shopify.com/store/tu-tienda/products?sku={{ $('Consolidar stock').item.json.sku }}|Abrir en Shopify>",
        "otherOptions": {"includeLinkToWorkflow": true}
      },
      "name": "Slack · Alerta #ops-inventario",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.2,
      "position": [1560, 540],
      "id": "slack-alert"
    },
    {
      "parameters": {
        "conditions": {
          "number": [
            {"value1": "={{ $('Consolidar stock').item.json.stock_proveedor }}", "operation": "smaller", "value2": 3}
          ]
        }
      },
      "name": "IF · Crítico (<3)",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1780, 540],
      "id": "if-critical"
    },
    {
      "parameters": {
        "select": "channel",
        "channelId": {"__rl": true, "value": "C0000MGMTVIP", "mode": "id"},
        "text": "=:warning: *CRÍTICO* — SKU `{{ $('Consolidar stock').item.json.sku }}` con solo *{{ $('Consolidar stock').item.json.stock_proveedor }}* unidades. Considerar pausar campañas activas para este producto.",
        "otherOptions": {}
      },
      "name": "Slack · Escalada a Management",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.2,
      "position": [2000, 540],
      "id": "slack-escalation"
    }
  ],
  "connections": {
    "Cron · Cada 6h": {"main": [[{"node": "HTTP · Proveedor Principal", "type": "main", "index": 0}]]},
    "HTTP · Proveedor Principal": {"main": [[{"node": "Split · SKUs proveedor", "type": "main", "index": 0}]]},
    "Split · SKUs proveedor": {"main": [[{"node": "Airtable · Lookup SKU", "type": "main", "index": 0}]]},
    "Airtable · Lookup SKU": {"main": [[{"node": "Consolidar stock", "type": "main", "index": 0}]]},
    "Consolidar stock": {"main": [[{"node": "Airtable · Update stock", "type": "main", "index": 0}, {"node": "IF · Stock bajo umbral", "type": "main", "index": 0}]]},
    "Airtable · Update stock": {"main": [[{"node": "Shopify · Sync inventario", "type": "main", "index": 0}]]},
    "IF · Stock bajo umbral": {"main": [[{"node": "Slack · Alerta #ops-inventario", "type": "main", "index": 0}], []]},
    "Slack · Alerta #ops-inventario": {"main": [[{"node": "IF · Crítico (<3)", "type": "main", "index": 0}]]},
    "IF · Crítico (<3)": {"main": [[{"node": "Slack · Escalada a Management", "type": "main", "index": 0}], []]}
  },
  "active": false,
  "settings": {"executionOrder": "v1"},
  "versionId": "1.0.0"
}
