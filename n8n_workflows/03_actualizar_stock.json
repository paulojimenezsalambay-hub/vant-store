    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const raw = $input.item.json;\nlet data;\nif (typeof raw.body === 'string') {\n  try { data = JSON.parse(raw.body); } catch(e) { data = {}; }\n} else if (raw.body && typeof raw.body === 'object') {\n  data = raw.body;\n} else {\n  data = raw;\n}\nconst id    = String(data.id_producto    || '').trim();\nconst stock = Number(data.stock_disponible);\nif (!id)                        throw new Error('id_producto es requerido');\nif (isNaN(stock) || stock < 0)  throw new Error('stock_disponible debe ser un número >= 0');\nreturn { json: { id_producto: id, stock_disponible: stock } };"
      },
      "name": "Code · Parsear y Validar",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [460, 300],
      "id": "d3e4f5a6-b7c8-9012-defa-345678901202"
    },
    {
